@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using AcademyCW.Models
@inject IDbContextFactory<AcademyCWContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
@*     <h2>Discipline</h2>
    <hr /> *@
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@discipline.discipline_name</h1>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_name}")" class="btn btn-primary">Изменить</a>
        </div>
        <dl class="row">
            <dt class="col-sm-2">discipline_name</dt>
            <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">number_of_lessons</dt>
            <dd class="col-sm-10">@discipline.number_of_lessons</dd>
            <dt class="col-sm-2">Teachers</dt>
            <dd class="col-sm-10">
                @if (discipline.Teachers is { Count: > 0 })
                {
                    foreach (var t in discipline.Teachers)
                    {
                        <a href="@($"/teachers/details?teacher_id={t.teacher_id}")">@t.full_name</a><br />
                    }
                }
                else
                {
                    <span class="text-muted">нет преподавателей</span>
                }
            </dd>
        </dl>
        <div>
            @* <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")">Edit</a> | *@
            <a href="@($"/disciplines")">Back to List</a>
        </div>
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.Include(d => d.Teachers).FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NotFound();
        }
    }
}

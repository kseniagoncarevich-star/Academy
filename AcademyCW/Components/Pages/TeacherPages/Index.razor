@page "/teachers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyCW.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyCWContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <h1>Преподаватели</h1>

    <p>
        <a href="teachers/create" class="btn btn-primary">Добавить</a>
    </p>

    <div>
        <input type="text" @bind="searchString" @bind:event="oninput" class="form-control" placeholder="Поиск по названию..." />
    </div>

    <div>
        <label for="items-per-page">Элементов на странице:</label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage" class="form-control">
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="13">13</option>
        </select>
    </div>
</div>

<QuickGrid Class="table" Items="@FilteredTeacher" Pagination="pagination">
    <TemplateColumn Context="teacher"
                    Title="Преподаватель">
        <a href="@($"/teachers/details?teacher_id={teacher.teacher_id}")">@teacher.full_name</a>
    </TemplateColumn>
	@* <PropertyColumn Property="teacher => teacher.full_name" Title="Преподаватель" /> *@
    @* <PropertyColumn Property="teacher => teacher.Disciplines" Title="Дисциплины" /> *@
@*     <PropertyColumn Property="teacher => teacher.first_name" />
    <PropertyColumn Property="teacher => teacher.last_name" />
    <PropertyColumn Property="teacher => teacher.middle_name" /> *@
    <PropertyColumn Property="teacher => teacher.birth_date" Title="Дата рождения" />
@*     <PropertyColumn Property="teacher => teacher.email" />
    <PropertyColumn Property="teacher => teacher.phone" />
    <PropertyColumn Property="teacher => teacher.photo" /> *@
    
    <PropertyColumn Property="teacher => teacher.work_since" Title="Работает с " />
    <PropertyColumn Property="teacher => teacher.rate" />

    <TemplateColumn Context="teacher">
@*         <a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
        <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a>|
        <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>  *@
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />

@code {
    private AcademyCWContext context = default!;

    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    private string searchString = "";

    private IQueryable<Teacher> FilteredTeacher
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchString))
            {
                return context.Teachers;
            }

            return context.Teachers.Where(g => g.full_name.Contains(searchString));
        }
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
